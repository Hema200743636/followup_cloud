rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    match /teachers/{id} {
      allow read: if signedIn() && request.auth.uid == id;
      allow write: if false;
    }

    match /students/{sid} {
      allow read: if isTeacher() || (signedIn() && request.auth.uid == sid);
      allow write: if isTeacher();
    }

    match /records/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.sid == request.auth.uid);
      allow create, update: if isTeacher() ||
        (isStudent()
         && request.resource.data.sid == request.auth.uid
         && id == request.auth.uid + '_' + request.resource.data.d
         && request.resource.data.keys().hasOnly(['sid','d','p','b']));
      allow delete: if isTeacher();
    }

    match /mrecords/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.sid == request.auth.uid);
      allow create, update: if isTeacher() ||
        (isStudent()
         && request.resource.data.sid == request.auth.uid
         && id == request.auth.uid + '_' + request.resource.data.m
         && request.resource.data.keys().hasOnly(['sid','m','c','f']));
      allow delete: if isTeacher();
    }
  }
}
